# Lightweight Unix build; upstream Autotools and CMake builds remain available.
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra
CPPFLAGS += -DEXCLUDE_CONFIG_H -DHAVE_GETOPT_H -DHAVE_NCURSES_H \
 -DHAVE_SYS_IOCTL_H -DHAVE_UNISTD_H -DHAVE_TERMIOS_H \
 -DHAVE_USE_DEFAULT_COLORS -DHAVE_RESIZETERM -DHAVE_WRESIZE \
 -DVERSION='"cmatrix-christ"'
CURSES_CFLAGS := $(shell pkg-config --cflags ncursesw)
CURSES_LIBS := $(shell pkg-config --libs ncursesw)

.PHONY: all test
all: build/cmatrix

build/cmatrix: cmatrix.c
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CURSES_CFLAGS) $< $(LDFLAGS) $(CURSES_LIBS) -lm -o $@

test: build/cmatrix
	python3 tests/test_cross_pty.py build/cmatrix
